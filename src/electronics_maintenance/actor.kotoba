(ns electronics-maintenance.actor
  "ElectronicsMaintenanceActor — the ISCO-08 3155 ATC electronics maintenance administrative
  support actor as a `langgraph.graph/state-graph` (per ADR-2607011000 / CLAUDE.md Actors section).
  One graph run = one maintenance support request (intake → advise → govern → decide
  → commit/hold, with a human-approval interrupt for escalated proposals). No
  infinite internal loop; checkpointed per superstep so an interrupted run can
  resume after human sign-off.

  CRITICAL: This actor supports administrative / ground / pre-shift / post-shift
  back-office operations ONLY. It never performs equipment repair, authorizes calibration,
  or exercises operational/technical authority. All such proposals
  are hard blocks. See `electronics-maintenance.governor` for complete scope exclusions.

  ```text
  :intake -> :advise -> :govern -> :decide -+-> :commit           (:ok? true)
                                             +-> :request-approval  (:escalate? true, interrupt-before)
                                             +-> :hold              (:hard? true)
  ```

  The unconditional invariant: the ElectronicsMaintenanceAdvisor can never
  directly commit a record or dispatch an action the ElectronicsMaintenanceGovernor
  refuses — every commit-operation! call is gated behind `:decide`.

  Human sign-off goes through `approve!`, which names the approver and
  refuses (recording the refusal) unless the thread is waiting at
  `:request-approval` -- see `electronics-maintenance.operation`."
  (:require [langgraph.graph :as g]
            [langgraph.checkpoint :as cp]
            [electronics-maintenance.advisor :as advisor]
            [electronics-maintenance.governor :as governor]
            [electronics-maintenance.store :as store]
            [electronics-maintenance.ledger :as ledger]
            [electronics-maintenance.operation :as operation]))

(defn build-graph
  "Build a compiled ElectronicsMaintenanceActor graph. `store` implements
  `electronics-maintenance.store/Store`. `advisor` implements
  `electronics-maintenance.advisor/Advisor` (defaults to `mock-advisor`).
  `checkpointer` defaults to an in-memory one."
  [{:keys [store advisor checkpointer]
    :or {advisor (advisor/mock-advisor)
         checkpointer (cp/mem-checkpointer)}}]
  (-> (g/state-graph
       {:channels
        {:request     {:default nil}
         :context     {:default nil}
         :proposal    {:default nil}
         :verdict     {:default nil}
         :disposition {:default nil}
         :operation   {:default nil}
         :approval    {:default nil}
         :audit       {:reducer into :default []}}})
      (g/add-node :intake (fn [s] s))
      (g/add-node :advise
                   (fn [{:keys [request]}]
                     (let [p (advisor/-advise advisor store request)]
                       {:proposal p
                        :audit [{:node :advise :request request :proposal p}]})))
      (g/add-node :govern
                   (fn [{:keys [request context proposal]}]
                     (let [v (governor/check request context proposal store)]
                       {:verdict v
                        :audit [{:node :govern :verdict v}]})))
      (g/add-node :decide
                   (fn [{:keys [request verdict]}]
                     (let [d (cond
                               (:hard? verdict) :hold
                               (:escalate? verdict) :request-approval
                               :else :commit)]
                       (when (= :request-approval d)
                         (ledger/append! store {:event :escalated :disposition :request-approval
                                                :request request :verdict verdict}))
                       {:disposition d})))
      (g/add-node :request-approval (fn [s] s))
      (g/add-node :commit
                   (fn [{:keys [request proposal approval]}]
                     (let [operation {:technician-id (:technician-id request)
                                      :facility-id (:facility-id request)
                                      :op (:op proposal)
                                      :payload proposal}]
                       (operation/commit! store operation (:approver approval))
                       {:operation operation
                        :audit [{:node :commit :operation operation}]})))
      (g/add-node :hold
                   (fn [{:keys [verdict]}]
                     (ledger/append! store {:event :held :disposition :hold :verdict verdict})
                     {:audit [{:node :hold :verdict verdict}]}))
      (g/set-entry-point :intake)
      (g/add-edge :intake :advise)
      (g/add-edge :advise :govern)
      (g/add-edge :govern :decide)
      (g/add-conditional-edges
       :decide
       (fn [{:keys [disposition]}]
         (case disposition
           :commit :commit
           :request-approval :request-approval
           :hold)))
      (g/add-edge :request-approval :commit)
      (g/set-finish-point :commit)
      (g/set-finish-point :hold)
      (g/compile-graph {:checkpointer checkpointer
                         :interrupt-before #{:request-approval}})))

(defn run-request!
  "Run one operation request to completion or interrupt. `thread-id`
  scopes checkpointing for resume after human approval. Returns the
  full run result: `{:state .. :events .. :status :done|:interrupted
  :frontier ..}`."
  [graph request context thread-id]
  (g/run* graph {:request request :context context} {:thread-id thread-id}))

(defn approve!
  "Human-in-the-loop sign-off by `approver` on the thread `thread-id`.
  Resumes the interrupted `:request-approval` node straight to
  `:commit`, which records `approver` as `:approved-by`. Refuses --
  appending an `:approval-refused` ledger entry to `store` and running
  nothing -- per `electronics-maintenance.operation/approval-refusal`.
  Returns the run result, or `{:status :refused :reason kw}`."
  [graph store thread-id approver]
  (if-let [why (operation/approval-refusal (g/get-state graph thread-id) approver)]
    (do (ledger/append! store {:event :approval-refused :thread-id thread-id
                               :approver approver :reason why})
        {:status :refused :reason why})
    (g/run* graph {:approval {:approver approver}}
            {:thread-id thread-id :resume? true})))
